# Crea il bot scrivendo a @BotFather e incolla il token solo nel file .env.
TELEGRAM_BOT_TOKEN=

# Scrivi un messaggio al bot, visita getUpdates e copia message.chat.id.
TELEGRAM_CHAT_ID=

# Frequenza dei controlli locali (minimo 30 secondi).
CHECK_INTERVAL_SECONDS=300

# true = non invia messaggi Telegram (utile per le prove).
DRY_RUN=false

# Usa un browser invisibile come ripiego per i siti protetti.
BROWSER_FALLBACK=true
